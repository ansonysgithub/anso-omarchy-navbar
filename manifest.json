{
  "schemaVersion": 1,
  "id": "anso.statusline",
  "name": "Anso Statusline",
  "version": "0.4.0-anso.3",
  "author": "anso (forked from lucas/omarchy-statusline)",
  "description": "CPU, memory, GPU, all-drive disk space, temperature, network and Logitech mouse battery at a glance.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Anso Statusline",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "layout": "default",
      "autoStart": true,
      "intervalSeconds": 2,
      "showHistory": true,
      "metrics": [
        "mouse",
        "cpu",
        "heat",
        "gpu",
        "memory",
        "net",
        "vpn",
        "ip"
      ]
    }
  }
}
